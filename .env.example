# Copy to .env. Needed for POST /api/admin/reload; leave empty to disable reloads.
ADMIN_TOKEN=
# Frontend origin allowed by CORS (comma-separated for several).
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_PER_MINUTE=60
# Password for the site. Leave empty locally for no password; on Vercel it is required.
SITE_PASSWORD=
# Optional extra secret for signing session cookies. Changing it (or the password) signs everyone out.
SESSION_SECRET=
SESSION_DAYS=7
# Staff passcode for invoices. Leave empty to turn invoicing off.
STAFF_PASSCODE=
# Signs staff tokens; required when STAFF_PASSCODE is set.
SECRET_KEY=
# Invoice and design-job database. Default: SQLite in var/. On Vercel use the hosted (Neon)
# **pooled** URL, e.g. postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Only for running migrations from your machine (python backend/scripts/migrate.py): Neon's
# direct (unpooled) URL, e.g. postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Not needed on Vercel.
DATABASE_URL_UNPOOLED=
# Only for tests: a throwaway Postgres (never production) for the row-lock and migration tests.
TEST_DATABASE_URL=
# Gmail app password (myaccount.google.com/apppasswords). Set = every invoice and payment
# is emailed to email.to in config/invoice.yaml. SMTP_USER defaults to that address.
SMTP_PASSWORD=
SMTP_USER=
