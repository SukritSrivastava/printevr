# Copy to .env. Needed for POST /api/admin/reload and GET /api/admin/status (load errors,
# why invoicing is off, schema state); leave empty to disable both.
ADMIN_TOKEN=
# Frontend origin allowed by CORS (comma-separated for several).
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_PER_MINUTE=60
# Login limits (10 site / 5 staff a minute per client): "auto" counts them in the database when
# DATABASE_URL is Postgres, so every instance shares them; "memory" counts per process;
# "database" forces the database (needs migration 0004). Falls back to memory if the database
# can't be used.
RATE_LIMIT_BACKEND=auto
# In-memory limiters forget the least recently seen clients beyond this many.
RATE_LIMIT_MAX_KEYS=10000
# Behind a proxy that appends the client to X-Forwarded-For (Vercel sets 1 by itself; nginx in
# docker compose). Leave 0 when clients reach the API directly, or they could forge their address.
TRUST_PROXY_HEADERS=0
# Proxies in front of the API that append to X-Forwarded-For (the client is this many from the right).
TRUSTED_PROXY_HOPS=1
# Optional: only believe forwarded headers from these peers (comma-separated IPs or CIDRs).
TRUSTED_PROXIES=
# Password for the site. Leave empty locally for no password; on Vercel it is required.
SITE_PASSWORD=
# Optional extra secret for signing session cookies. Changing it (or the password) signs everyone out.
SESSION_SECRET=
SESSION_DAYS=7
# Staff passcode for invoices. Leave empty to turn invoicing off.
STAFF_PASSCODE=
# Signs staff tokens; required when STAFF_PASSCODE is set.
SECRET_KEY=
# Admin passcode for the Employees tab and attendance corrections (needs SECRET_KEY). Leave
# empty to turn those changes off; checking in and out still works.
ADMIN_PASSCODE=
# Invoice and design-job database. Default: SQLite in var/. On Vercel use the hosted (Neon)
# **pooled** URL, e.g. postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Only for running migrations from your machine (python backend/scripts/migrate.py): Neon's
# direct (unpooled) URL, e.g. postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Not needed on Vercel. Apply migrations BEFORE deploying code that needs them (README).
DATABASE_URL_UNPOOLED=
# Only for tests: a throwaway Postgres (never production) for the row-lock and migration tests.
TEST_DATABASE_URL=
# Gmail app password (myaccount.google.com/apppasswords). Set = every invoice and payment
# is emailed to email.to in config/invoice.yaml. SMTP_USER defaults to that address.
SMTP_PASSWORD=
SMTP_USER=
